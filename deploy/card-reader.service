# Card Reader as a systemd service — the non-Docker path.
#
# Install:
#   sudo useradd --system --home /opt/card-reader --shell /usr/sbin/nologin cardreader
#   sudo cp -r . /opt/card-reader && cd /opt/card-reader
#   sudo python3 -m venv .venv && sudo ./.venv/bin/pip install -r requirements.txt
#   sudo mkdir -p /var/lib/card-reader && sudo chown cardreader: /var/lib/card-reader
#   sudo cp deploy/card-reader.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now card-reader
#
# Logs:   journalctl -u card-reader -f

[Unit]
Description=Card Reader — business card lead extractor
Documentation=https://github.com/bharatsachya/card-reader
# ORDERED AFTER OLLAMA, AND THAT IS WEAKER THAN IT LOOKS.
#
# After= orders STARTUP, not readiness. systemd considers ollama.service
# "started" as soon as the process is up and listening -- which is seconds --
# but Ollama does not load the 3.2 GB model until the first request arrives,
# and that load takes tens of seconds on this box. So after a reboot the app
# will be serving before the model can answer.
#
# The practical consequence: THE FIRST UPLOAD AFTER A REBOOT MAY FAIL, or take
# far longer than a normal card, while the weights are read in. The app handles
# it correctly rather than crashing -- the request is retried
# (MODEL_MAX_ATTEMPTS) and, if it still fails, becomes a flagged model_error
# row naming the reason. But it is a real rough edge and it is documented in
# the README rather than hidden.
#
# Wants= rather than Requires= so that a failed or absent ollama does not stop
# the app booting: it still serves the UI and reports the model as unreachable
# on /health, which is far more useful than refusing to start.
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=exec
User=cardreader
Group=cardreader
WorkingDirectory=/opt/card-reader

# State lives OUTSIDE the deployment directory, so redeploying by replacing
# /opt/card-reader cannot delete the database and the retained images.
Environment="DB_PATH=/var/lib/card-reader/leads.db"
Environment="IMAGE_DIR=/var/lib/card-reader/images"
Environment="STORE_BACKEND=sqlite"
# Ollama is on this same box, on loopback, and stays there.
Environment="MODEL_URL=http://127.0.0.1:11434/v1/chat/completions"
Environment="MODEL_NAME=qwen2.5vl:3b"
# Above the slowest measured card (172s) with real headroom.
Environment="MODEL_TIMEOUT_SECONDS=600"
Environment="IMAGE_RETENTION_DAYS=7"
Environment="RECLAIM_STALE_JOBS=true"
Environment="AUTH_MODE=local"
EnvironmentFile=-/etc/card-reader.env

# One worker. Job state is an asyncio task inside ONE process, so a second
# worker would accept uploads it cannot then report on. The model serves one
# request at a time anyway.
ExecStart=/opt/card-reader/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1

Restart=on-failure
RestartSec=5
# Give an in-flight card time to finish before SIGKILL. Cards already extracted
# are committed per card, so the worst case loses one card, not the batch.
TimeoutStopSec=30

# --- Hardening. Each line removes something the app demonstrably never uses. ---
NoNewPrivileges=true
PrivateTmp=true
# Read-only filesystem except for the paths named below. StateDirectory gives
# us /var/lib/card-reader with the right owner, created automatically.
ProtectSystem=strict
ProtectHome=true
StateDirectory=card-reader
ReadWritePaths=/var/lib/card-reader
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
# The app makes outbound HTTP to the model and to Clerk's JWKS, and listens on
# TCP. It has no use for anything else.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The app talks to Ollama on loopback and to nginx on loopback. With Clerk
# enabled it also needs outbound HTTPS for the JWKS; leave this commented
# unless you turn AUTH_MODE=clerk on.
# IPAddressAllow=localhost
# IPAddressDeny=any

[Install]
WantedBy=multi-user.target
