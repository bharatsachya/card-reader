# Card Reader configuration.
#
# Copy to .env and edit. Every setting has a working default, so an empty file
# is a valid configuration for local development.
#
# REAL ENVIRONMENT VARIABLES ALWAYS WIN over this file (app/config.py uses
# setdefault), so a value injected by Docker, systemd or Azure is never
# clobbered by a stray .env left on the box.

# ============================================================================
# Model endpoint — the two variables that move between backends
# ============================================================================

# Any OpenAI-compatible /v1/chat/completions URL. Ollama, llama.cpp's
# llama-server, vLLM and OpenAI all speak this shape.
#   local ollama   http://localhost:11434/v1/chat/completions
#   docker compose http://ollama:11434/v1/chat/completions
#   remote GPU     http://10.0.1.23:8080/v1/chat/completions
MODEL_URL=http://localhost:11434/v1/chat/completions

# The model identifier sent in the request body.
MODEL_NAME=qwen2.5vl:3b

# Sent as `Authorization: Bearer` when set. Ollama and llama.cpp ignore it;
# vLLM and hosted endpoints require it.
MODEL_API_KEY=

# Per-request timeout, seconds. A CPU-hosted 3B VLM takes ~170s per card on
# 2 vCPU, so this must stay comfortably above your measured worst case.
MODEL_TIMEOUT_SECONDS=180

# Retries per card on transient failure (model still loading, socket reset).
MODEL_MAX_ATTEMPTS=3
# First backoff wait in seconds; doubles each attempt.
MODEL_RETRY_BASE_SECONDS=1

# ============================================================================
# Storage
# ============================================================================

# sqlite = persists across restarts, required for `--workers N`.
# memory = the original dict; loses everything on restart. Tests and debugging.
STORE_BACKEND=sqlite

# Relative paths resolve against the working directory (/app in the container).
DB_PATH=./data/leads.db
IMAGE_DIR=./data/images

# On startup, flip jobs still marked queued/running to failed. A job's worker
# is an asyncio task inside one process, so a process that dies leaves a row
# that would otherwise claim to be running forever.
#
# *** SET THIS TO false IF YOU RUN MORE THAN ONE REPLICA. *** A replica that
# starts later would otherwise kill another replica's genuinely live job.
RECLAIM_STALE_JOBS=true

# How long a retained card image is kept, in days. 0 = keep forever.
# The extracted LEAD is always kept; only the image expires.
#
# *** REVISIT THIS WHEN MODEL_URL POINTS AT A GPU. *** The disk ceiling is a
# function of how slow inference is: at ~170s/card this box cannot exceed ~508
# cards/day, so 30 days is bounded under 4 GB. At 2s/card that is ~85x more.
IMAGE_RETENTION_DAYS=30

# ============================================================================
# Authentication
# ============================================================================

# clerk = verify real Clerk session tokens.
# local = every request runs as a single fixed user. Development and fallback.
#
# AUTH_MODE=clerk with either value below missing is a HARD STARTUP FAILURE,
# deliberately: auth that silently disables itself when misconfigured would
# serve every user's leads to every visitor with a healthy /health.
AUTH_MODE=local

# Both values are PUBLIC. The publishable key is designed to ship in browser
# HTML; the issuer is a URL. CLERK_SECRET_KEY is NOT used by this project and
# is read nowhere in the codebase — verification uses Clerk's public keys only.
#
# THEY MUST BE THE SAME CLERK INSTANCE. The publishable key decides who MINTS
# the token; the issuer decides whose signature is ACCEPTED. Mixing them makes
# every token look like it came from a foreign tenant, and all of them fail.
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=

# ============================================================================
# Backpressure — every one of these rejects work before it costs memory
# ============================================================================

MAX_UPLOAD_BYTES=15728640       # 15 MB per file, enforced mid-stream
MAX_FILES_PER_REQUEST=20        # ~57 min worst case at the measured 172s/card
MAX_IMAGE_PIXELS=89478485       # decompression-bomb ceiling
MAX_IMAGE_EDGE=1024             # longest edge sent to the model

# Cards in flight at once. THIS BOUNDS PEAK MEMORY: ~100 MB per image being
# decoded, so peak = MAX_CONCURRENCY x 100 MB regardless of batch size.
# Keep at 1 for llama.cpp/ollama, which serve one request at a time. Raise it
# only for a backend with real batching (vLLM on a GPU).
MAX_CONCURRENCY=1

MAX_JOBS_RETAINED=50            # in-memory backend only; sqlite keeps history
UPLOAD_DIR=                     # blank = system temp
DEFAULT_PHONE_REGION=IN         # region assumed for numbers with no + prefix

# ============================================================================
# Serving
# ============================================================================

# PORT is read by the container entrypoint; Azure injects it automatically.
# PORT=8000
# Workers. MUST stay 1 while a job is an in-process asyncio task.
# WEB_CONCURRENCY=1
