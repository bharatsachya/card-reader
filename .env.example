# Copy to .env and edit. Nothing here is required; every value has a default.

# --- Model endpoint (OpenAI-compatible /v1/chat/completions) ---
# Local Ollama (default):
MODEL_URL=http://localhost:11434/v1/chat/completions
MODEL_NAME=qwen2.5vl:3b

# Local llama.cpp llama-server example:
# MODEL_URL=http://localhost:8080/v1/chat/completions
# MODEL_NAME=Qwen3-VL-2B-Instruct

# Remote AWS example:
# MODEL_URL=http://10.0.1.23:8080/v1/chat/completions
# MODEL_NAME=Qwen3-VL-2B-Instruct-Q4_K_M
# MODEL_API_KEY=

# Seconds to wait for the model before giving up (CPU inference is slow).
MODEL_TIMEOUT_SECONDS=180

# --- Image preprocessing ---
MAX_IMAGE_EDGE=1024

# --- Post-processing ---
# ISO 3166-1 alpha-2 region used for phone numbers with no country code.
DEFAULT_PHONE_REGION=IN

# --- Authentication (Clerk) ---
# Leave BOTH blank to disable auth entirely; the app then runs standalone.
# Only public values are needed: verification uses Clerk's published JWKS, so
# CLERK_SECRET_KEY is deliberately not used by this project.
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# --- Retry / limits ---
MODEL_MAX_ATTEMPTS=3
MODEL_RETRY_BASE_SECONDS=1
MAX_UPLOAD_BYTES=15728640
MAX_FILES_PER_REQUEST=50
MAX_CONCURRENCY=1
MAX_JOBS_RETAINED=50
